# Lokale Entwicklung: nach .env kopieren
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://einlass:einlass@localhost:5432/einlass
# mindestens 32 Zeichen, z. B. `openssl rand -base64 48`
JWT_SECRET=bitte-durch-einen-langen-zufaelligen-wert-ersetzen
# In der Entwicklung ohne HTTPS: false
COOKIE_SECURE=false
SESSION_HOURS=12
# Unix-Socket von einlass-hostd (fehlt er, wird die Uhr nicht verstellt)
HOSTD_SOCKET=/run/einlass/hostd.sock
# Erster Admin – wird nur angelegt, wenn noch kein Admin existiert
ADMIN_INITIAL_NAME=admin
ADMIN_INITIAL_PASSWORD=
