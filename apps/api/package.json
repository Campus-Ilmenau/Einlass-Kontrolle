{
  "name": "@einlass/api",
  "version": "0.0.0",
  "private": true,
  "description": "API der Einlass-Kontrolle (Fastify, TypeORM, PostgreSQL)",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@einlass/shared": "workspace:*",
    "@fastify/cookie": "11.1.5",
    "@fastify/jwt": "10.2.7",
    "@fastify/multipart": "10.1.6",
    "@fastify/rate-limit": "11.2.2",
    "@node-rs/argon2": "2.2.2",
    "csv-parse": "7.0.3",
    "fastify": "5.12.8",
    "fastify-type-provider-zod": "7.0.0",
    "pg": "8.23.1",
    "pino": "^10.4.0",
    "read-excel-file": "9.3.14",
    "typeorm": "1.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "8.23.1",
    "embedded-postgres": "18.6.0-beta.19",
    "tsx": "4.23.15",
    "vitest": "5.1.0",
    "write-excel-file": "4.1.1"
  }
}
