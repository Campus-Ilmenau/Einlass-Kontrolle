#!/bin/bash
# Läuft innerhalb von cage (Wayland). Dreht das Display und startet Chromium im Kiosk-Modus.
set -eu
# shellcheck source=/dev/null
. /etc/einlass/kiosk.env  # nur root + kiosk lesbar (Display-Token), erzeugt von einlass-display-render

wlr-randr --output "${DISPLAY_OUTPUT:-DSI-1}" --transform "${DISPLAY_TRANSFORM:-normal}" || true

# Beim Booten laufen die Docker-Container evtl. noch nicht: bis zu 2 min auf die Display-Seite
# warten, sonst die statische Seite (QR-Codes, Uhr) als Rückfallebene zeigen
# Der Domain-Name wird direkt auf den Pi selbst aufgelöst (unabhängig von /etc/hosts, das
# cloud-init beim Booten neu schreibt)
URL="$KIOSK_URL"
DOMAIN="${DOMAIN:-einlass.lan}"
probe() { curl -sk -o /dev/null --max-time 2 --resolve "$DOMAIN:443:127.0.0.1" "${URL%%\?*}"; }
case "$URL" in
https://*)
  for _ in $(seq 1 60); do
    probe && break
    sleep 2
  done
  probe || URL="file:///opt/einlass/display/index.html"
  ;;
esac

exec chromium \
  --ozone-platform=wayland \
  --kiosk "$URL" \
  --host-resolver-rules="MAP $DOMAIN 127.0.0.1" \
  --incognito \
  --lang=de-DE \
  --noerrdialogs \
  --disable-infobars \
  --no-first-run \
  --no-default-browser-check \
  --disable-translate \
  --disable-features=Translate,TouchpadOverscrollHistoryNavigation \
  --overscroll-history-navigation=0 \
  --disable-pinch \
  --hide-crash-restore-bubble \
  --disable-session-crashed-bubble \
  --password-store=basic \
  --check-for-update-interval=31536000 \
  --allow-file-access-from-files \
  --user-data-dir=/var/lib/einlass-kiosk/chromium
