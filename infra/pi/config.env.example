# Konfiguration für den Einlass-Pi.
# Wird beim ersten Setup nach /etc/einlass/config.env kopiert (dort ist die maßgebliche Version).
# Leere Werte werden beim Setup automatisch erzeugt.

# WLAN-Ländercode (Regulierung der Funkkanäle)
COUNTRY=DE

# Access Point
WIFI_SSID=Einlass-Kontrolle
# 8–63 Zeichen. Leer lassen → wird zufällig erzeugt (12 Zeichen, gut abtippbar)
WIFI_PASSWORD=
WIFI_CHANNEL=6

# Netz im WLAN des Pi
AP_IP=10.42.0.1
AP_PREFIX=24
DHCP_START=10.42.0.20
DHCP_END=10.42.0.250

# Name, unter dem die App im WLAN erreichbar ist
DOMAIN=einlass.lan

# Laufzeit des self-signed Zertifikats in Tagen.
# Apple akzeptiert für TLS-Server-Zertifikate max. 825 Tage.
TLS_DAYS=825
# Erneuern, wenn das Zertifikat in weniger als so vielen Tagen abläuft
TLS_RENEW_BEFORE_DAYS=90
